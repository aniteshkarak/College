[Unit]
Description=Collage Story Daily Database and Private Storage Backup
After=network.target docker.service
Wants=docker.service

[Service]
Type=oneshot
User=collage
WorkingDirectory=/var/www/collage-story/backend
EnvironmentFile=/var/www/collage-story/backend/.env
ExecStart=/usr/bin/node scripts/backup/runScheduledBackup.js
StandardOutput=append:/var/log/collage-story/backup.log
StandardError=append:/var/log/collage-story/backup_error.log
Restart=on-failure
RestartSec=60s

[Install]
WantedBy=multi-user.target
