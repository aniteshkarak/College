# Collégé Backend Environment Configuration (Phase 1)
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database (Docker container: college-postgres)
DATABASE_URL="postgresql://college_user:college_dev_pass@127.0.0.1:5432/college_db?schema=public"

# Redis Cache & Pub/Sub (Docker container: college-redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication (JWT + Argon2)
JWT_SECRET=college_super_secure_jwt_dev_key_2026_phase1
JWT_EXPIRES_IN=7d
