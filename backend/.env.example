# Collage Story Backend Environment Configuration Template
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database (Docker container: college-postgres)
DATABASE_URL="postgresql://db_user:db_password@127.0.0.1:5432/college_db?schema=public"

# Redis Cache & Background Queue (Docker container: college-redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_if_any

# Authentication (JWT + Argon2)
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here
JWT_REFRESH_EXPIRES_IN=30d

# Administrator Seed Defaults
ADMIN_SUPER_EMAIL=admin@college.internal
ADMIN_SUPER_PASSWORD=your_secure_admin_password_here

# Nodemailer SMTP Configuration (Transactional Emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="Collage Story Campus Team <no-reply@college.internal>"

# Storage & Privacy
MAX_FILE_SIZE_BYTES=5242880
