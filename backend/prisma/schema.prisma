datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. PENDING REGISTRATION (Pre-approval Application)
// No active user account exists while in this model!
// -------------------------------------------------------------
model PendingRegistration {
  id                    String    @id @default(uuid())
  applicationId         String    @unique // e.g. COL-2026-001234
  status                String    @default("PENDING_REVIEW") // DRAFT | PENDING_REVIEW | UNDER_REVIEW | NEEDS_CORRECTION | RESUBMITTED | APPROVED | REJECTED
  
  // Step 1: Personal Information
  legalName             String
  displayName           String
  dateOfBirth           DateTime
  age                   Int
  gender                String?
  city                  String
  state                 String
  languagesSpoken       String[]
  email                 String    @unique
  isEmailVerified       Boolean   @default(false)
  emailVerifiedAt       DateTime?
  mobileNumber          String    @unique
  isMobileVerified      Boolean   @default(false)
  mobileVerifiedAt      DateTime?
  passwordHash          String    // Stored securely, activated only upon approval

  // Step 2: College & Education Information
  collegeId             String?
  collegeName           String
  universityName        String?
  collegeLocation       String?
  collegeState          String?
  degreeName            String
  departmentStream      String
  academicYear          String    // 1st Year, 2nd Year, etc.
  currentSemester       String?
  graduationYear        Int
  studentStatus         String    // CURRENTLY_STUDYING | RECENTLY_GRADUATED | OTHER

  // Step 5: About & Connection Preferences
  bio                   String
  interests             String[]
  hobbies               String[]
  personality           String?
  lookingFor            String    // Friendship | Casual chatting | Dating | Serious relationship
  ageRangeMin           Int       @default(18)
  ageRangeMax           Int       @default(26)
  preferredDistance     String    // SAME_COLLEGE | SAME_CITY | ANYWHERE_INDIA

  // Step 6: Consents & DPDP Compliance
  termsAccepted         Boolean   @default(false)
  privacyAccepted       Boolean   @default(false)
  ageConfirmed18Plus    Boolean   @default(false)
  verificationConsent   Boolean   @default(false)
  consentedAt           DateTime  @default(now())

  // 72-Hour Verification Metrics
  submittedAt           DateTime  @default(now())
  reviewDeadline        DateTime  // submittedAt + 72 hours
  isOverdue             Boolean   @default(false)

  // Review & Correction State
  assignedAdminId       String?
  reviewStartedAt       DateTime?
  correctionFields      String[]  // List of field keys requiring correction
  correctionMessage     String?   // Admin message explaining what needs to be fixed
  rejectionReason       String?   // Admin reason if rejected
  reviewedAt            DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relationships
  identityDocument      IdentityDocument?
  photographs           UserPhoto[]
  reviewHistory         VerificationHistory[]
  createdUser           User?     @relation("ApplicationUser")

  @@index([status])
  @@index([submittedAt])
  @@index([reviewDeadline])
  @@index([collegeName])
}

// -------------------------------------------------------------
// 2. ACTIVE USER (Created ONLY upon Administrator Approval!)
// -------------------------------------------------------------
model User {
  id                    String    @id @default(uuid())
  applicationId         String?   @unique // Link to original approved application
  email                 String    @unique
  passwordHash          String
  mobileNumber          String    @unique
  fullName              String
  displayName           String
  dateOfBirth           DateTime
  age                   Int
  gender                String?
  accountStatus         String    @default("ACTIVE") // ACTIVE | SUSPENDED
  role                  String    @default("STUDENT") // STUDENT | ADMIN | SUPER_ADMIN
  
  // Verification Audit
  verificationStatus    String    @default("APPROVED") // APPROVED
  approvedAt            DateTime?
  approvedByAdminId     String?

  // Subscription Plan (PRD: Free, ₹49, ₹99 per 28 days)
  subscriptionPlan      String    @default("free") // free | pro_49 | unlimited_99
  planExpiresAt         DateTime?
  sentRequestsCount     Int       @default(0)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relationships
  application           PendingRegistration? @relation("ApplicationUser", fields: [applicationId], references: [id])
  profile               UserProfile?
  education             Education?
  identityDocuments     IdentityDocument[]
  photos                UserPhoto[]
  consents              UserConsent[]
  sessions              UserSession[]

  // Platform features (Strictly accessible only when accountStatus == ACTIVE)
  sentRequests          MatchRequest[]       @relation("SentRequests")
  receivedRequests      MatchRequest[]       @relation("ReceivedRequests")
  matchesAsUser1        Match[]              @relation("User1Matches")
  matchesAsUser2        Match[]              @relation("User2Matches")
  sentMessages          Message[]
  announcements         CampusAnnouncement[]
  reportsFiled          Report[]             @relation("Reporter")
  reportsReceived       Report[]             @relation("ReportedUser")
  blocksInitiated       UserBlock[]          @relation("BlocksInitiated")
  blocksReceived        UserBlock[]          @relation("BlocksReceived")
  notifications         Notification[]
}

// -------------------------------------------------------------
// 3. USER PROFILE (Created after manual approval)
// -------------------------------------------------------------
model UserProfile {
  id                    String    @id @default(uuid())
  userId                String    @unique
  bio                   String
  interests             String[]
  hobbies               String[]
  personality           String?
  relationshipIntention String    @default("Casual Connection")
  lookingFor            String    @default("Friendship")
  ageRangeMin           Int       @default(18)
  ageRangeMax           Int       @default(26)
  preferredDistance     String    @default("ANYWHERE_INDIA")
  city                  String
  state                 String
  languages             String[]
  currentMood           String?   @default("Want to make friends")
  moodUpdatedAt         DateTime? @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// 4. EDUCATION (Verified student record)
// -------------------------------------------------------------
model Education {
  id                    String    @id @default(uuid())
  userId                String    @unique
  collegeId             String?
  collegeName           String
  universityName        String?
  degreeName            String
  departmentStream      String
  academicYear          String
  currentSemester       String?
  graduationYear        Int
  studentStatus         String
  isVerified            Boolean   @default(true)
  verifiedAt            DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  college               College?  @relation(fields: [collegeId], references: [id])
}

// -------------------------------------------------------------
// 5. COLLEGE REGISTRY (Searchable institution list + requests)
// -------------------------------------------------------------
model College {
  id                    String    @id @default(uuid())
  name                  String    @unique
  universityName        String?
  city                  String
  state                 String
  isVerified            Boolean   @default(true)
  isUserRequested       Boolean   @default(false)
  requestedByEmail      String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  educations            Education[]
}

// -------------------------------------------------------------
// 6. IDENTITY VERIFICATION DOCUMENT (Stored privately)
// -------------------------------------------------------------
model IdentityDocument {
  id                    String    @id @default(uuid())
  registrationId        String?   @unique
  userId                String?
  documentType          String    // COLLEGE_ID | VOTER_ID | AADHAAR_MASKED
  documentNumberMasked  String?
  filePath              String    // Private storage path (never public!)
  fileName              String
  fileSize              Int
  mimeType              String
  fileHashSha256        String?
  isVerified            Boolean   @default(false)
  verifiedAt            DateTime?
  rejectionReason       String?
  submittedAt           DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  registration          PendingRegistration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user                  User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// 7. USER PHOTOGRAPHS (Exactly 3 photographs required)
// -------------------------------------------------------------
model UserPhoto {
  id                    String    @id @default(uuid())
  registrationId        String?
  userId                String?
  photoUrl              String    // Private or public-after-approval URL
  photoOrder            Int       // 1 = Main Avatar, 2 = Personal Photo 1, 3 = Personal Photo 2
  isMain                Boolean   @default(false)
  isApproved            Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  registration          PendingRegistration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user                  User?                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([registrationId, photoOrder])
}

// -------------------------------------------------------------
// 8. VERIFICATION HISTORY & AUDIT TRAIL
// -------------------------------------------------------------
model VerificationHistory {
  id                    String    @id @default(uuid())
  registrationId        String
  adminId               String
  adminName             String
  action                String    // ASSIGNED | STARTED_REVIEW | REQUESTED_CORRECTION | RESUBMITTED | APPROVED | REJECTED
  notes                 String?
  correctionFields      String[]
  timestamp             DateTime  @default(now())

  registration          PendingRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
}

// -------------------------------------------------------------
// 9. ADMIN USERS & ROLES
// -------------------------------------------------------------
model Admin {
  id                    String    @id @default(uuid())
  email                 String    @unique
  fullName              String
  passwordHash          String
  roleName              String    @default("VERIFICATION_ADMIN") // SUPER_ADMIN | VERIFICATION_ADMIN | SUPPORT_ADMIN
  isActive              Boolean   @default(true)
  lastLoginAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  auditLogs             AdminAuditLog[]
}

model AdminAuditLog {
  id                    String    @id @default(uuid())
  adminId               String
  action                String
  targetType            String    // APPLICATION | USER | DOCUMENT
  targetId              String
  details               String
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime  @default(now())

  admin                 Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([targetId])
}

// -------------------------------------------------------------
// 10. USER CONSENT & SESSION (DPDP Act Compliance)
// -------------------------------------------------------------
model UserConsent {
  id                    String    @id @default(uuid())
  userId                String
  consentType           String    // TERMS_OF_SERVICE | PRIVACY_POLICY | MANUAL_VERIFICATION | ID_PROCESSING
  isGranted             Boolean   @default(true)
  ipAddress             String?
  grantedAt             DateTime  @default(now())

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id                    String    @id @default(uuid())
  userId                String
  tokenHash             String
  ipAddress             String?
  userAgent             String?
  expiresAt             DateTime
  createdAt             DateTime  @default(now())

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// 11. SOCIAL CORE: Match, Conversations, Messages, Campus Board
// -------------------------------------------------------------
model MatchRequest {
  id          String   @id @default(uuid())
  senderId    String
  receiverId  String
  status      String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sender      User     @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model Match {
  id             String           @id @default(uuid())
  user1Id        String
  user2Id        String
  status         String           @default("ACTIVE")
  stage          String           @default("Friend") // Friend -> Dating -> Relationship
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user1          User             @relation("User1Matches", fields: [user1Id], references: [id], onDelete: Cascade)
  user2          User             @relation("User2Matches", fields: [user2Id], references: [id], onDelete: Cascade)
  conversation   Conversation?
  goRequests     GoStageRequest[]

  @@unique([user1Id, user2Id])
}

model GoStageRequest {
  id            String   @id @default(uuid())
  matchId       String
  initiatorId   String
  targetStage   String   // Dating | Relationship
  status        String   @default("PENDING") // PENDING | ACCEPTED | REFUSED
  refusalReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String    @id @default(uuid())
  matchId   String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  messageType    String       @default("TEXT") // TEXT | VOICE_NOTE | SYSTEM_PROMPT
  mediaUrl       String?
  voiceDuration  Int?         // in seconds (max 60s)
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model CampusAnnouncement {
  id          String   @id @default(uuid())
  collegeName String
  title       String
  content     String
  category    String   @default("General")
  isUrgent    Boolean  @default(false)
  upvotes     Int      @default(0)
  authorId    String
  createdAt   DateTime @default(now())

  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([collegeName])
}

model Report {
  id             String   @id @default(uuid())
  reporterId     String
  reportedUserId String
  category       String
  reason         String
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())

  reporter       User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User     @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// 12. NOTIFICATIONS (In-app notification system)
// -------------------------------------------------------------
model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String   // APPLICATION_SUBMITTED | APPLICATION_APPROVED | APPLICATION_REJECTED | CORRECTION_REQUESTED | LIKE | MATCH | TEXT_MESSAGE | VOICE_MESSAGE | CAMPUS
  title       String
  body        String
  data        Json?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// -------------------------------------------------------------
// 13. USER BLOCK LIST (Safety & Blocking)
// -------------------------------------------------------------
model UserBlock {
  id          String   @id @default(uuid())
  blockerId   String
  blockedId   String
  reason      String?
  createdAt   DateTime @default(now())

  blocker     User     @relation("BlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked     User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}
